*{box-sizing:border-box}body{margin:0;min-height:100vh;background:#111;color:#000;font-family:'Courier New',monospace;padding:22px}button,input{font:inherit}button{cursor:pointer;background:#d4d0c8;border:3px outset #fff;color:#000;padding:9px 12px;font-weight:bold}button:active{border-style:inset}button:disabled{opacity:.5;cursor:not-allowed}.hidden{display:none!important}.window{max-width:1536px;margin:auto;background:#d4d0c8;border:3px ridge #eee;box-shadow:5px 5px #000}.title-bar{background:#000080;color:#fff;padding:9px 12px;display:flex;justify-content:space-between;letter-spacing:1px}.menu-bar{padding:8px 12px;border-bottom:2px solid #777}.home{padding:30px;min-height:510px;text-align:center}.home h1{font-size:32px;letter-spacing:3px}.home>p{color:#444}.home-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:700px;margin:35px auto}.panel{background:#c0c0c0;border:2px inset #fff;padding:20px;text-align:left}.panel h2{font-size:17px;border-bottom:1px solid #888;padding-bottom:10px}.panel label{display:block;font-size:13px;margin:12px 0 5px}.panel input{width:100%;padding:11px;border:2px inset #fff}.panel button{width:100%;margin-top:14px}.lobby{max-width:520px;margin:25px auto}.lobby>p{text-align:center;font-size:13px}.room-banner,.terminal{background:#000;color:#00ff66;padding:16px;text-align:center}.room-banner strong{font-size:26px;letter-spacing:3px}.player-list{background:white;min-height:100px;padding:12px}.player-entry{padding:10px;border-bottom:1px dotted #aaa;display:flex;gap:8px}.host-label{margin-left:auto}.terminal{text-align:left;font-size:12px;margin-top:12px}.status-bar{border-top:2px solid #888;background:#c0c0c0;padding:8px 12px;display:flex;justify-content:space-between;font-size:12px}.game-screen{padding:9px}.game-columns{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(380px,1fr);gap:10px}.left-side,.right-side{min-width:0}.board-frame{background:#084f86;border:3px inset #fff;overflow:hidden}.board-frame img{display:block;width:100%;height:auto;image-rendering:auto}.bottom-strip{display:grid;grid-template-columns:190px 1fr;gap:8px;margin-top:8px;min-height:113px}.server-box,.special-box{border:3px inset #fff;padding:12px;background:#c0c0c0}.server-box{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:9px;font-size:12px}.server-box strong{font-size:19px;letter-spacing:2px}.special-box h3{margin:0 0 8px;font-size:14px}.special-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.special-grid>div{background:#d4d0c8;border:2px inset #fff;padding:10px;display:flex;flex-direction:column;gap:5px}.special-grid small{font-size:12px}.section-head{background:#000080;color:#fff;padding:7px 10px;font-size:17px;font-weight:bold;letter-spacing:1px;margin-bottom:4px}.table-wrap{margin-bottom:10px;border:2px inset #fff}table{width:100%;border-collapse:collapse;font-size:13px}th,td{border:1px solid #888;padding:12px 7px;text-align:center}th:first-child,td:first-child{text-align:left}th{background:#c0c0c0}td{background:#d4d0c8}.color-square{display:inline-block;width:15px;height:15px;border:2px solid #111;vertical-align:middle;margin:0 5px}.red{background:#e82727}.blue{background:#1266f1}.green{background:#1da33c}.yellow{background:#e6cb19}.star{color:#dba500;font-size:19px}.online{color:green}.offline{color:#bd1818}.turn-panel{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:12px;border:2px inset #fff;margin-bottom:10px;min-height:85px}.turn-panel small{display:block;margin-top:7px}.dice-area{display:flex;align-items:center;gap:8px}.dice-area strong{font-size:23px}.actions{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;margin-bottom:10px}.actions button{min-width:0;min-height:82px;padding:6px 3px;font-size:21px}.actions button span{display:block;font-size:11px;margin-top:7px;overflow-wrap:anywhere}.game-log{height:260px;overflow-y:auto;background:#f6f6f6;border:3px inset #fff;padding:8px;font-size:12px;line-height:1.65}.game-log div{border-bottom:1px dotted #ddd}.game-log time{color:#555;margin-right:7px}@media(max-width:1000px){.game-columns{grid-template-columns:1fr}.game-log{height:200px}}@media(max-width:600px){body{padding:6px}.home{padding:12px}.home-grid{grid-template-columns:1fr}.bottom-strip{grid-template-columns:1fr}.actions{grid-template-columns:repeat(3,1fr)}.turn-panel{flex-wrap:wrap}th,td{padding:8px 3px;font-size:11px}.section-head{font-size:14px}.home h1{font-size:24px}}


/* v0.3: independent light/dark theme and decorative shoreline */
.menu-bar{display:flex;align-items:center;gap:19px;position:relative;z-index:5}
.view-menu{position:relative}
.menu-bar #view-menu-toggle{border:0;background:transparent;padding:0;font-size:inherit;font-weight:normal;color:inherit}
.view-dropdown{position:absolute;top:100%;left:0;min-width:185px;padding:5px;background:#d4d0c8;border:2px outset #fff;box-shadow:3px 3px 0 #111;z-index:10}
.view-dropdown button{display:block;width:100%;text-align:left;font-size:12px;font-weight:normal;padding:9px 8px;border:0;background:transparent;color:inherit}
.view-dropdown button:hover{background:#000080;color:white}
.board-frame{position:relative}
.shore-waves{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:.72}
.shore-waves path{fill:none;stroke-linecap:round;vector-effect:non-scaling-stroke}
.wave-back{stroke:#58d6ff;stroke-width:4;stroke-dasharray:18 31;animation:shore-flow 8s linear infinite;filter:drop-shadow(0 1px 2px #0b5985)}
.wave-front{stroke:#e9faff;stroke-width:2;stroke-dasharray:9 44;stroke-dashoffset:22;animation:shore-flow 6s linear infinite reverse}
@keyframes shore-flow{to{stroke-dashoffset:-196}}
body.dark-theme{background:#0c0b16;color:#eee}
.dark-theme .window{background:#282536;color:#f0edf8;border-color:#5e5574;box-shadow:5px 5px #050409}
.dark-theme .title-bar,.dark-theme .section-head{background:#432478;color:#fff}
.dark-theme .menu-bar,.dark-theme .status-bar{background:#302b40;color:#f3efff;border-color:#625b74}
.dark-theme .view-dropdown{background:#302b40;border-color:#776e8c}
.dark-theme .view-dropdown button:hover{background:#6543a5}
.dark-theme .home>p{color:#bdb6ce}
.dark-theme .panel,.dark-theme .server-box,.dark-theme .special-box{background:#343044;border-color:#686078}
.dark-theme .special-grid>div,.dark-theme .turn-panel,.dark-theme td{background:#383348;color:#f0edf8;border-color:#655d75}
.dark-theme th{background:#4c435f;color:#fff;border-color:#746b85}
.dark-theme .table-wrap,.dark-theme .turn-panel,.dark-theme .game-log{border-color:#776d8a}
.dark-theme .player-list,.dark-theme .game-log{background:#201d2b;color:#eae5f6}
.dark-theme .game-log div{border-color:#443d52}
.dark-theme .game-log time{color:#afa5c4}
.dark-theme button:not(#view-menu-toggle):not(.view-dropdown button){background:#4c435f;color:#f6f2ff;border-color:#7b718e}
.dark-theme button:not(#view-menu-toggle):not(.view-dropdown button):hover{background:#605476}
.dark-theme input{background:#211d2e;color:white;border-color:#776d8a}
.dark-theme .room-banner,.dark-theme .terminal{background:#100f19;color:#42fa98}
.dark-theme .online{color:#4df39c}
.dark-theme .offline{color:#ff6c7e}
@media(prefers-reduced-motion:reduce){.shore-waves path{animation:none}}

/* Decorative pixel ships; SVG tracks scale with the map image. */
.ocean-boats{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:hidden}
.boat-sprite{filter:drop-shadow(1px 2px 1px #00335d)}
@media(prefers-reduced-motion:reduce){.ocean-boats{display:none}}

/* v0.5 construction hotspots: all positions scale with the island artwork */
.build-overlay{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}
.build-overlay .build-edge,.build-overlay .build-vertex{stroke:transparent;fill:transparent}
.build-overlay .build-edge.available{stroke:#f6f05b;stroke-width:15;stroke-linecap:round;opacity:.76;pointer-events:stroke;cursor:pointer;stroke-dasharray:10 8}
.build-overlay .build-vertex.available{fill:#f6f05b;stroke:#151515;stroke-width:3;opacity:.92;pointer-events:all;cursor:pointer}
.build-overlay .built-road{stroke-width:11;stroke-linecap:round;opacity:.95;pointer-events:none}
.build-overlay .built-settlement{stroke:#fff;stroke-width:3;pointer-events:none}
.build-hint{font-size:12px;padding:7px 9px;min-height:30px;background:#ece9df;margin-bottom:6px}
.dark-theme .build-hint{background:#302b40;color:#f3efff}
.actions button.selected{outline:3px solid #d2a900;outline-offset:-4px}
@media(prefers-reduced-motion:reduce){.build-overlay{display:block}}

/* v0.6 procedural board; independent of the light/dark UI theme */
.terrain-board{display:block;width:100%;height:auto;background:#065b96}
.terrain-tile{stroke:#f7c849;stroke-width:9;stroke-linejoin:round}
.terrain-rim{fill:none;stroke:#6c3e12;stroke-width:2;pointer-events:none}
.tile-number{fill:#f9e6c1;stroke:#996c32;stroke-width:3}
.tile-number-text{font:bold 32px Georgia,serif;text-anchor:middle;dominant-baseline:central;fill:#252018}
.tile-number-text.hot{fill:#bd2929}
.terrain-label{font:bold 13px 'Courier New',monospace;fill:#fff;text-anchor:middle;paint-order:stroke;stroke:#172a30;stroke-width:3}
.board-seed{font:bold 13px 'Courier New',monospace;fill:#fff;paint-order:stroke;stroke:#093a64;stroke-width:4}

/* v0.6.1: island base image, precisely shared hexagon edges and vertices */
.hex-rim{fill:none;stroke:#ffcf45;stroke-width:5;stroke-linejoin:round;paint-order:stroke}
.hex-cell{filter:drop-shadow(0 1px 2px #65401a)}
.build-overlay .build-edge.available{stroke:#f8ee52;stroke-width:11;opacity:.85}
.build-overlay .build-vertex.available{fill:#ffe75b;stroke:#a83424;stroke-width:3}
.build-overlay .built-road{stroke-width:9}
.build-overlay .built-settlement{stroke-width:3}

/* v0.6.3 private resource inventory, below the scrollable game log */
.inventory-head{margin-top:12px}
.inventory{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:5px;padding:7px;border:2px inset #fff;background:#c0c0c0}
.inventory-card{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-width:0;padding:9px 2px;background:#d4d0c8;border:2px outset #fff;text-align:center}
.inventory-card span{font-size:23px}.inventory-card small{font-size:11px}.inventory-card strong{font-size:19px}
.inventory-total{padding:7px 9px;font-size:11px;border:2px inset #fff;background:#c0c0c0;margin-bottom:10px}
.dark-theme .inventory,.dark-theme .inventory-total{background:#302b40;border-color:#776d8a;color:#f4f0fc}
.dark-theme .inventory-card{background:#433b55;border-color:#716783;color:#f4f0fc}
