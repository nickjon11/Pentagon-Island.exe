<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Pentagon Island</title><link rel="stylesheet" href="/static/css/style.css"></head>
<body><div class="window"><header class="title-bar"><strong>▣ PENTAGON ISLAND.EXE</strong><span>▁ ▣ ×</span></header><nav class="menu-bar"><span>Game</span><div class="view-menu"><button id="view-menu-toggle" type="button" aria-expanded="false">View ▾</button><div id="view-dropdown" class="view-dropdown hidden"><button type="button" id="theme-light">☀ Light Theme</button><button type="button" id="theme-dark">☾ Dark Theme</button></div></div><span>Multiplayer</span><span>Help</span></nav>
<main id="home-screen" class="home"><h1>PENTAGON ISLAND</h1><p>Multiplayer Strategy Game</p><div class="home-grid"><section class="panel"><h2>CREATE GAME</h2><label for="create-name">PLAYER NAME</label><input id="create-name" maxlength="16" placeholder="Enter name..."><button id="create-room">CREATE ROOM</button></section><section class="panel"><h2>JOIN GAME</h2><label for="join-name">PLAYER NAME</label><input id="join-name" maxlength="16" placeholder="Enter name..."><label for="room-code">ROOM CODE</label><input id="room-code" maxlength="6" placeholder="XXXXXX"><button id="join-room">JOIN ROOM</button></section></div></main>
<section id="lobby-screen" class="home hidden"><h1>PENTAGON ISLAND</h1><p>Multiplayer Strategy Game</p><div class="panel lobby"><h2>MULTIPLAYER LOBBY</h2><div class="room-banner">ROOM CODE: <strong id="lobby-room-code">------</strong></div><p>Share this code with other players.</p><h3>PLAYERS</h3><div id="player-list" class="player-list"></div><button id="start-game" class="hidden">START GAME</button><div class="terminal waiting-message">&gt; WAITING FOR PLAYERS...</div></div></section>
<section id="game-screen" class="game-screen hidden"><div class="game-columns"><div class="left-side"><div class="board-frame"><svg id="terrain-board" class="terrain-board" viewBox="0 0 900 781" role="img" aria-label="Randomized 19-hex island terrain"></svg><svg id="build-overlay" class="build-overlay" viewBox="0 0 900 781" preserveAspectRatio="none" aria-label="Construction locations"></svg></div><div class="bottom-strip"><div class="server-box"><span>🟢 SERVER ONLINE</span><strong id="game-room-code">------</strong></div><div class="special-box"><h3>SPECIAL CARDS</h3><div class="special-grid"><div>🛤️ <strong>Longest Road</strong><small id="longest-road">Not awarded</small></div><div>⚔️ <strong>Largest Army</strong><small id="largest-army">Not awarded</small></div></div></div></div></div><div class="right-side"><div class="section-head">PLAYERS</div><div class="table-wrap"><table><thead><tr><th>Player</th><th>Turn</th><th>VP</th><th id="last-column-head">Connection</th></tr></thead><tbody id="game-players"></tbody></table></div><div class="section-head">CURRENT PLAYER</div><div class="turn-panel"><div><strong id="current-player">—</strong><small id="turn-info">Turn 1</small></div><div class="dice-area"><strong id="dice-result">⚄ ⚄</strong><button id="roll-dice">ROLL DICE</button></div></div><div class="section-head">ACTIONS</div><div id="build-hint" class="build-hint">Choose Road or Settlement to see building spots.</div><div class="actions"><button id="build-road">🛤️<span>Build Road</span></button><button id="build-settlement">🏠<span>Settlement</span></button><button id="build-city">🏰<span>City</span></button><button data-placeholder="Trading">↔️<span>Trade</span></button><button id="end-turn">🚩<span>End Turn</span></button></div><div class="section-head">GAME LOG</div><div id="game-log" class="game-log" role="log" aria-live="polite"></div><div class="section-head inventory-head">INVENTORY</div><div id="inventory" class="inventory" aria-label="Your private resource inventory"></div><div id="inventory-total" class="inventory-total">Total cards: 0</div></div></div></section>
<footer class="status-bar"><span>● SERVER ONLINE <span id="footer-room"></span></span><span>MULTIPLAYER v0.6.3</span></footer></div><script src="/static/js/main.js"></script></body></html>
